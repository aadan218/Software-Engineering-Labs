<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane fx:id="loginScreen" prefHeight="400.0" prefWidth="360.0"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.openjfx.lab2.controller.LoginController">
   <children>
      <TextField fx:id="username" layoutX="40.0" layoutY="40.0" prefWidth="280.0" promptText="username" />
      <Label fx:id="notext" alignment="CENTER" layoutX="20.0" layoutY="85.0" prefWidth="320.0" textFill="RED"
             nodeOrientation="RIGHT_TO_LEFT" wrapText="true" />
      <PasswordField fx:id="password" layoutX="40.0" layoutY="125.0" prefWidth="280.0" promptText="password" />
      <Button fx:id="loginButton" layoutX="150.0" layoutY="180.0" mnemonicParsing="false" onAction="#onLoginClick" text="login" defaultButton="true" />
      <Button fx:id="testButton" layoutX="130.0" layoutY="225.0" mnemonicParsing="false" onAction="#onSyncTestClick" text="sync test" />
      <Label fx:id="testResult" layoutX="20.0" layoutY="260.0" prefWidth="320.0" wrapText="true" style="-fx-font-size: 11px;" />
   </children>
</AnchorPane>
