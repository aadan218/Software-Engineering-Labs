<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane fx:id="loginScreen" prefHeight="260.0" prefWidth="360.0"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.openjfx.lab2.controller.LoginController">
   <children>
      <TextField fx:id="username" layoutX="40.0" layoutY="40.0" prefWidth="280.0" promptText="username" />
      <Label fx:id="notext" alignment="CENTER" layoutX="40.0" layoutY="90.0" prefWidth="280.0" textFill="RED" />
      <PasswordField fx:id="password" layoutX="40.0" layoutY="125.0" prefWidth="280.0" promptText="password" />
      <Button layoutX="150.0" layoutY="180.0" mnemonicParsing="false" onAction="#onLoginClick" text="login" defaultButton="true" />
   </children>
</AnchorPane>
